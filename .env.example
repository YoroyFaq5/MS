FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-me-in-production-use-a-long-random-string

# Обязателен — приложение не запустится без него (см. app/config.py).
# База данных должна быть создана с CHARACTER SET utf8mb4 (см. README) —
# приложение русскоязычное и хранит эмодзи в некоторых текстовых полях.
DATABASE_URL=mysql+pymysql://user:password@localhost/mafia_style?charset=utf8mb4

# Migration API (/migration/*) — ТОЛЬКО на время одноразового переноса
# данных из старой версии приложения. По умолчанию выключен (роутов не
# существует вообще, 404). Включить на время миграции, затем убрать обе
# переменные из .env — это и есть выключатель.
# MIGRATION_API_ENABLED=true
# MIGRATION_API_TOKEN=сгенерируй-длинный-случайный-секрет-сюда

# Вебхук MafiaSpace (/api/mafiaspace/games) — приём завершённых игр от
# внешнего сервиса. Без этой переменной эндпоинт отвечает 503 (не
# настроен), а не 401 — так проще отличить "забыли настроить" от
# "прислали неверный токен".
# MAFIASPACE_WEBHOOK_TOKEN=msp_wh_...

# Telegram-бот (MS-TelegramBot, отдельный репозиторий) — уведомления о
# событиях сайта доставляются через очередь (см.
# app/services/notify_outbox_service.py), не напрямую. Без BOT_EVENTS_URL/
# INCOMING_EVENT_SECRET события просто копятся в notify_outbox_events и
# никуда не доставляются (фича тихо выключена, сайт не ломается).
# BOT_EVENTS_URL=https://<бот>.pythonanywhere.com
# INCOMING_EVENT_SECRET=
# MAIN_API_SERVICE_TOKEN=
# TELEGRAM_BOT_USERNAME=mafiastyle_bot

# Опциональный фоновый поток, доставляющий очередь уведомлений боту прямо
# из веб-процесса — альтернатива cron-записи `flask outbox-drain`.
# Выключен по умолчанию: каждый `flask ...`-вызов и каждый тест тоже
# создают приложение через create_app(), им фоновый поток не нужен.
# OUTBOX_WORKER_ENABLED=true
# OUTBOX_POLL_SECONDS=15
